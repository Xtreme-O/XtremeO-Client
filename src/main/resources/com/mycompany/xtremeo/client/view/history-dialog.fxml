<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="dialogRoot" spacing="0" styleClass="history-dialog-container"
      stylesheets="@styles/history-dialog.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.xtremeo.client.controller.HistoryDialogController">
    
    <padding>
        <Insets top="0" right="0" bottom="16" left="16"/>
    </padding>
    
    <HBox alignment="CENTER_LEFT">
        <padding>
            <Insets top="14" bottom="12" right="16"/>
        </padding>
        <FontIcon iconLiteral="mdi2h-history" styleClass="history-header-icon"/>
        <Label styleClass="history-dialog-title" text="LAST GAMES"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeBtn" onAction="#handleClose" styleClass="history-close-button">
            <graphic>
                <FontIcon iconLiteral="mdi2c-close" styleClass="history-close-icon"/>
            </graphic>
        </Button>
    </HBox>
    
    <ListView fx:id="historyListView" styleClass="history-list-view" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="No games played yet" styleClass="history-placeholder"/>
        </placeholder>
    </ListView>
    
</VBox>
