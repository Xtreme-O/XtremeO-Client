<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="chatPanelRoot" styleClass="chat-sidebar"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.xtremeo.client.controller.lobby.LobbyChatController">
    
    <HBox styleClass="chat-header" alignment="CENTER_LEFT">
        <Label styleClass="chat-title" text="Global Chat" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="5">
            <Region styleClass="live-dot" />
            <Label styleClass="live-text" text="Live" />
        </HBox>
    </HBox>
    
    <ScrollPane fx:id="chatScroll" styleClass="chat-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="messagesContainer" styleClass="chat-messages" spacing="14" />
    </ScrollPane>
    
    <HBox fx:id="quickChatContainer" styleClass="quick-chat-container" spacing="6" alignment="CENTER_LEFT">
        <Button styleClass="quick-chat-btn" text="Good Luck!" />
        <Button styleClass="quick-chat-btn" text="GG WP" />
        <Button styleClass="quick-chat-btn" text="One more?" />
    </HBox>
    
    <VBox styleClass="chat-input-container">
        <HBox styleClass="chat-input-wrapper" alignment="CENTER_LEFT" spacing="6">
            <TextField fx:id="txtChatInput" styleClass="chat-input" promptText="Type a message..." HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSend" onAction="#handleSend" styleClass="send-btn">
                <graphic><FontIcon iconLiteral="mdi2s-send" styleClass="send-icon"/></graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
