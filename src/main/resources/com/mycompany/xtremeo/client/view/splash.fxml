<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" styleClass="main-background" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.xtremeo.client.controller.SplashController">
   <children>
      <VBox alignment="CENTER" spacing="30.0">
         <children>
            <StackPane maxHeight="180.0" maxWidth="180.0" styleClass="icon-container">
               <children>
                  <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label styleClass="icon-x-dim" text="✕" />
                        <Circle radius="15.0" styleClass="icon-o-dim" GridPane.columnIndex="2" />
                        <StackPane styleClass="icon-center-highlight" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label styleClass="icon-x-bright" text="✕" />
                           </children>
                        </StackPane>
                        <Circle radius="15.0" styleClass="icon-o-dim" GridPane.rowIndex="2" />
                        <Label styleClass="icon-x-dim" text="✕" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                     </children>
                  </GridPane>
               </children>
            </StackPane>

            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-white" text="TIC TAC" />
                        <Text fill="#ffcc00" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-gold" text="TOE" />
                     </children>
                  </HBox>
                  <Text fill="#aaaaaa" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="subtitle" text="Ultimate Desktop Edition" />
               </children>
            </VBox>

            <VBox alignment="CENTER" maxWidth="400.0" spacing="10.0">
               <children>
                  <HBox>
                     <children>
                        <Label fx:id="statusLabel" text="Initializing game engine..." textFill="#bbbbbb" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="progressLabel" text="0%" textFill="#ffcc00" />
                     </children>
                  </HBox>
                  <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" prefHeight="6.0" progress="0.0" />
               </children>
            </VBox>
         </children>
      </VBox>
      
      <Label text="V1.0 © 2026" textFill="#555555" StackPane.alignment="BOTTOM_CENTER">
         <StackPane.margin>
            <javafx.geometry.Insets bottom="20.0" />
         </StackPane.margin>
      </Label>
   </children>
</StackPane>