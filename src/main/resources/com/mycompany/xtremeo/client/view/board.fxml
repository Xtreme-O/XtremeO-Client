<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainRoot" prefHeight="800.0" prefWidth="1200.0" styleClass="main-container" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.xtremeo.client.controller.BoardController" stylesheets="@styles/board.css">
    <top>
        <StackPane prefHeight="80.0" styleClass="header-bar">
            <HBox alignment="CENTER" spacing="32.0" styleClass="score-pill">
                <padding><Insets left="32.0" right="32.0" /></padding>
                <HBox alignment="CENTER" spacing="12.0">
                    <StackPane styleClass="player-icon-container-x">
                        <FontIcon iconLiteral="mdi2c-close-thick" styleClass="player-x-icon"/>
                    </StackPane>
                    <Label fx:id="scoreX" styleClass="score-value" text="0" />
                </HBox>
                <Separator orientation="VERTICAL" styleClass="score-separator" />
                <HBox alignment="CENTER" spacing="12.0">
                    <Label fx:id="scoreO" styleClass="score-value" text="0" />
                    <StackPane styleClass="player-icon-container-o">
                        <FontIcon iconLiteral="mdi2c-circle-outline" styleClass="player-o-icon"/>
                    </StackPane>
                </HBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <padding><Insets left="40.0" right="40.0" top="10" bottom="10" /></padding>
                <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBack" styleClass="btn-back">
                    <graphic>
                        <FontIcon iconLiteral="mdi2a-arrow-left" styleClass="btn-back-icon"/>
                    </graphic>
                </Button>
                <HBox alignment="CENTER" spacing="12.0">
                    <StackPane styleClass="logo-container">
                        <GridPane hgap="1" vgap="1" alignment="CENTER">
                            <FontIcon iconLiteral="mdi2c-close" styleClass="logo-x-dim" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                            <FontIcon iconLiteral="mdi2c-circle-outline" styleClass="logo-o-dim" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                            <FontIcon iconLiteral="mdi2c-close" styleClass="logo-x-bright" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                            <FontIcon iconLiteral="mdi2c-circle-outline" styleClass="logo-o-dim" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                            <FontIcon iconLiteral="mdi2c-close" styleClass="logo-x-dim" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>
                        </GridPane>
                    </StackPane>
                    <Label styleClass="header-title" text="XtremO" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnReset" mnemonicParsing="false" onAction="#handleReset" styleClass="btn-reset" text="Reset Game" />
            </HBox>
        </StackPane>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="32.0" styleClass="game-content">
            <HBox fx:id="turnIndicatorContainer" alignment="CENTER" maxWidth="280.0" spacing="12.0" styleClass="turn-indicator-pill">
                <Label styleClass="turn-icon-small" text="" />
                <Label fx:id="turnLabel" styleClass="turn-text" text="Player X's Turn" />
            </HBox>
            <StackPane maxWidth="500.0" prefHeight="500.0" styleClass="grid-outer-container">
                <GridPane fx:id="gameGrid" hgap="12.0" vgap="12.0">
                    <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <Button fx:id="btn00" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Button fx:id="btn01" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Button fx:id="btn02" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <Button fx:id="btn10" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Button fx:id="btn11" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Button fx:id="btn12" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <Button fx:id="btn20" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Button fx:id="btn21" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Button fx:id="btn22" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#handleCellClick" styleClass="grid-cell" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                </GridPane>
            </StackPane>
        </VBox>
    </center>

    <right>
        <fx:include fx:id="chatPanel" source="board-chat-panel.fxml"/>
    </right>
</BorderPane>