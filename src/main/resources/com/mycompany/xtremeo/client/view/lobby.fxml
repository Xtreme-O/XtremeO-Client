<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<StackPane fx:id="lobbyRoot" prefHeight="800.0" prefWidth="1200.0" styleClass="lobby-container"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.xtremeo.client.controller.LobbyController"
           stylesheets="@styles/lobby.css">
    
    <BorderPane>
        <top>
            <fx:include fx:id="header" source="lobby-header.fxml" />
        </top>
        
        <left>
            <VBox prefWidth="280" styleClass="profile-sidebar">
                <fx:include fx:id="profileCard" source="lobby-profile-card.fxml" VBox.vgrow="ALWAYS" />
            </VBox>
        </left>
        
        <center>
            <fx:include fx:id="playerList" source="lobby-player-list.fxml" />
        </center>
        
        <right>
            <fx:include fx:id="chatPanel" source="lobby-chat-panel.fxml" />
        </right>
    </BorderPane>
</StackPane>
